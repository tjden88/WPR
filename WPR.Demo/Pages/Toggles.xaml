<Page x:Class="WPR.Demo.Pages.Toggles"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:wpr="clr-namespace:WPR;assembly=WPR"
      mc:Ignorable="d" 
      Foreground="{DynamicResource TextColorBrush}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Переключатели">

    <Grid>
        <StackPanel Orientation="Horizontal">
            <StackPanel Width="200">
                <TextBlock Text="Чекбоксы" Margin="5"/>
                <CheckBox Content="Checked" Margin="5" IsChecked="True"/>
                <CheckBox Content="Unchecked" Margin="5"/>
                <CheckBox Content="CheckedDisabled" Margin="5" IsChecked="True" IsEnabled="False"/>
                <CheckBox Content="UncheckedDisabled" Margin="5" IsEnabled="False"/>
                <CheckBox Content="Tristate" Margin="5" IsThreeState="True" IsChecked="{x:Null}"/>
                <CheckBox Content="TristateDisabled" Margin="5" IsEnabled="False" IsChecked="{x:Null}"/>
                <TextBlock Text="Toggle Buttons" Margin="5"/>
                <Border Effect="{StaticResource PopupSmallShadow}">
                    <wpr:ClippingBorder ClipToBounds="True"
                                             CornerRadius="3"
                                             Background="{DynamicResource DividerColorBrush}"
                                             HorizontalAlignment="Center" 
                                             Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton IsChecked="True" wpr:Extra.BorderRadius="0" Margin="0"
                                          ToolTip="Полужирный">
                                <wpr:Icon Source="FormatBold" Width="34" IconSize="18"/>
                            </ToggleButton>
                            <ToggleButton wpr:Extra.BorderRadius="0" Margin="0"
                                          ToolTip="Наклонный">
                                <wpr:Icon Source="FormatItalic" Width="34" IconSize="18"/>
                            </ToggleButton>
                            <ToggleButton wpr:Extra.BorderRadius="0" Margin="0"
                                          ToolTip="Подчёркнутый">
                                <wpr:Icon Source="FormatUnderlined" Width="34" IconSize="18"/>
                            </ToggleButton>
                        </StackPanel>
                    </wpr:ClippingBorder>
                </Border>
                <ToggleButton Style="{StaticResource WPRSwitchToggleButton}" Content="Switcher" Margin="5"/>
                <ToggleButton Style="{StaticResource WPRSwitchToggleButton}" IsChecked="True" Content="SwitcherChecked" Margin="5"/>
                </StackPanel>
            <StackPanel Width="200">
                <TextBlock Text="Радио баттоны" Margin="5"/>
                <RadioButton Content="Selected" Margin="5" IsChecked="True"/>
                <RadioButton Content="Not selected" Margin="5"/>
                <RadioButton Content="Not selected" Margin="5"/>
                <RadioButton Content="TriState" Margin="5" IsThreeState="True" IsChecked="{x:Null}"/>
                <RadioButton Content="Selected Disabled" Margin="5" GroupName="1" IsEnabled="False" IsChecked="True"/>
                <RadioButton Content="Not Selected Disabled" Margin="5" GroupName="1" IsEnabled="False"/>
                <RadioButton Content="TriState Disabled" Margin="5" IsThreeState="True" IsChecked="{x:Null}" IsEnabled="False" GroupName="1"/>
                <TextBlock Text="Button-Styled" Margin="5"/>
                <wpr:ClippingBorder ClipToBounds="True"
                                            CornerRadius="3"
                                            Background="{DynamicResource DividerColorBrush}"
                                            HorizontalAlignment="Center" 
                                            Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource WPRRadioButtonButtonStyle}" IsChecked="True" Margin="0"
                                     wpr:Extra.BorderRadius="0"
                              ToolTip="По левому краю">
                            <wpr:Icon Source="FormatAlignLeft" Width="34" Height="18"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource WPRRadioButtonButtonStyle}"  Margin="0"
                                     wpr:Extra.BorderRadius="0"
                              ToolTip="По центру">
                            <wpr:Icon Source="FormatAlignCenter" Width="34" Height="18"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource WPRRadioButtonButtonStyle}"  Margin="0"
                                     wpr:Extra.BorderRadius="0"
                              ToolTip="По правому краю">
                            <wpr:Icon Source="FormatAlignRight" Width="34" Height="18"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource WPRRadioButtonButtonStyle}"  Margin="0"
                                     wpr:Extra.BorderRadius="0"
                              ToolTip="По ширине">
                            <wpr:Icon Source="FormatAlignJustify" Width="34" Height="18"/>
                        </RadioButton>
                    </StackPanel>
                </wpr:ClippingBorder>
            </StackPanel>
            <StackPanel>
                <wpr:TipDecorator Tip="Подсказка!">
                    <ToggleButton wpr:Extra.BorderRadius="30" IsChecked="False" BorderThickness="1" Margin="5" Padding="10">
                        <wpr:Icon Source="Star"/>
                    </ToggleButton>
                </wpr:TipDecorator>
                <wpr:TipDecorator Tip="Подсказка слева!" HorizontalContentAlignment="Right">
                    <ToggleButton wpr:Extra.BorderRadius="30" IsChecked="False" BorderThickness="1" Margin="5" Padding="10">
                        <wpr:Icon Source="Star"/>
                    </ToggleButton>
                </wpr:TipDecorator>
                <wpr:TipDecorator Tip="Подсказка в центре!" HorizontalContentAlignment="Center" VerticalContentAlignment="Bottom">
                    <ToggleButton wpr:Extra.BorderRadius="30" IsChecked="False" BorderThickness="1" Margin="5" Padding="10">
                        <wpr:Icon Source="Star"/>
                    </ToggleButton>
                </wpr:TipDecorator>
                <wpr:TipDecorator VerticalContentAlignment="Top" HorizontalContentAlignment="Center" TipMargin="50">
                    <wpr:TipDecorator.Tip>
                        <Button Padding="40">
                            <wpr:IconText IconSource="Burger" Text="Big One!"></wpr:IconText>
                        </Button>
                    </wpr:TipDecorator.Tip>
                    <ToggleButton wpr:Extra.BorderRadius="30" IsChecked="False" BorderThickness="1" Margin="5" Padding="10">
                        <wpr:Icon Source="Burger"/>
                    </ToggleButton>
                </wpr:TipDecorator>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
