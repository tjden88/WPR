<UserControl x:Class="WPR.Demo.WprDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wpr="clr-namespace:WPR;assembly=WPR"
             xmlns:demo="clr-namespace:WPR.Demo"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance demo:WprDialogViewModel }">
    <wpr:TitledCard Header="Пользовательский диалог">
        <StackPanel Margin="15">
            <TextBox wpr:Extra.TextHint="Имя" Margin="10" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"></TextBox>
            <wpr:NumericIntDecorator Value="{Binding Age}" PlusMinusButtonsShowing="True">
                <TextBox wpr:Extra.TextHint="Возраст" Margin="10" Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}"></TextBox>
            </wpr:NumericIntDecorator>
            <Separator/>
            <DockPanel LastChildFill="False">
                <Button Content="Ок" DockPanel.Dock="Right" Command="{Binding SaveCommand}" ></Button>
                <Button Content="Отмена" Command="{Binding CancelCommand}" DockPanel.Dock="Right"></Button>
                <Button Content="Сброс" Command="{Binding ResetCommand}" Style="{StaticResource WPRFlatButton}" DockPanel.Dock="Left"></Button>

            </DockPanel>
        </StackPanel>

    </wpr:TitledCard> 
</UserControl>
