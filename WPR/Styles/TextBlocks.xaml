<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Base.xaml"/>
</ResourceDictionary.MergedDictionaries>

    <Style x:Key="WPRTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FrameworkElementStyle}">
        <Setter Property="FontFamily" Value="{StaticResource RobotoFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextWrapping" Value="WrapWithOverflow"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.56"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CaptionText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource WPRTextBlock}">
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="BodyText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource WPRTextBlock}">
        <Setter Property="FontWeight" Value="Regular"/>
    </Style>

    <Style x:Key="BodyStrongText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource WPRTextBlock}">
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style x:Key="SubtitleText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource WPRTextBlock}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style x:Key="SubtitleLightText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource WPRTextBlock}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Regular"/>
    </Style>

    <Style x:Key="TitleText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource WPRTextBlock}">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style x:Key="LargeTitleText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource WPRTextBlock}">
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style x:Key="DisplayText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource WPRTextBlock}">
        <Setter Property="FontSize" Value="68"/>
        <Setter Property="FontWeight" Value="Regular"/>
    </Style>
</ResourceDictionary>