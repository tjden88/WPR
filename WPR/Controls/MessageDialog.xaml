<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib"
                    xmlns:dialogs="clr-namespace:WPR.Dialogs">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles/Base.xaml"/>
        <ResourceDictionary Source="../Styles/Buttons.xaml"/>
        <ResourceDictionary Source="../Styles/TextBlocks.xaml"/>
    </ResourceDictionary.MergedDictionaries>

        <s:Boolean x:Key="True">True</s:Boolean>
        <s:Boolean x:Key="False">False</s:Boolean>

    <Style TargetType="{x:Type dialogs:MessageDialog}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type dialogs:MessageDialog}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding Path=Title, RelativeSource={RelativeSource TemplatedParent}}" 
                                   FontWeight="Medium" 
                                   TextWrapping="WrapWithOverflow"
                                   Margin="10,10,10,0" 
                                   Visibility="{Binding Path=Title, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ValueIsNullToVisibilityConverter}}"
                                   HorizontalAlignment="Left">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource WPRTextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryColorBrush}"></Setter>
                                    <Setter Property="FontSize" Value="20"></Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsErrorMessage}" Value="true">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerColorBrush}"/>
                                            <Setter Property="FontSize" Value="24"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Bottom"
                                    HorizontalAlignment="Right" Margin="6">
                            <Button x:Name="Cancel" Content="{Binding Path=CancelButtonText, RelativeSource={RelativeSource TemplatedParent}}" Width="100"  IsCancel="True" Style="{StaticResource WPRFlatButton}"
                                    Command="{Binding Path=CancelButtonPressedCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsCancelButtonVisible , Converter={StaticResource Bool2VisibilityConverter}}"/>

                            <Button x:Name="Ok" Content="{Binding Path=AcceptButtonText, RelativeSource={RelativeSource TemplatedParent}}" Width="100" IsDefault="True"
                                    Command="{Binding Path=SubmitCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsAcceptButtonVisible , Converter={StaticResource Bool2VisibilityConverter}}"/>

                            <Button x:Name="No" Content="{Binding Path=QuestionCancelButtonText, RelativeSource={RelativeSource TemplatedParent}}" Width="100"  Style="{StaticResource WPRFlatButton}"
                                    Command="{Binding Path=CancelCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsQuestionButtonsVisible , Converter={StaticResource Bool2VisibilityConverter}}"/>

                            <Button x:Name="Yes" Content="{Binding Path=QuestionAcceptButtonText, RelativeSource={RelativeSource TemplatedParent}}" Width="100" IsDefault="True"
                                    Command="{Binding Path=SubmitCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsQuestionButtonsVisible , Converter={StaticResource Bool2VisibilityConverter}}"/>

                        </StackPanel>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <TextBlock TextWrapping="WrapWithOverflow"
                                       Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}" 
                                       Foreground="{DynamicResource TextColorBrush}" 
                                       Margin="10"/>
                        </ScrollViewer>
                    </DockPanel>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>