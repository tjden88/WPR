<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpr="clr-namespace:WPR">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles/Base.xaml"/>
        <ResourceDictionary Source="../Styles/Buttons.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    <Style TargetType="{x:Type wpr:InputDialog}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wpr:InputDialog}">
                    <Grid FocusManager.FocusedElement="{Binding ElementName=TextBox}">
                        <StackPanel Orientation="Vertical">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{DynamicResource PrimaryColorBrush}" 
                                       Text="{Binding Path=Title, Mode=OneTime, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="20"
                                       Margin="10"/>
                            <TextBlock TextWrapping="Wrap" Name="CaptionText"
                                       Foreground="{DynamicResource SecondaryColorBrush}" 
                                       Text="{Binding Path=Content, Mode=OneTime, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ValueIsNullToVisibilityConverter}}"
                                       Margin="10"/>
                            <TextBox Margin="10" x:Name="TextBox" 
                                     MinHeight="{Binding Path=MinTextBoxHeight, Mode=OneTime, RelativeSource={RelativeSource TemplatedParent}}"
                                     AcceptsReturn="{Binding Path=MultiLine, Mode=OneTime, RelativeSource={RelativeSource TemplatedParent}}"
                                     Text="{Binding Path=Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="6">
                                <Button x:Name="Cancel" Content="ОТМЕНА" Width="100" IsCancel="True" Style="{StaticResource WPRFlatButton}"
                                        Command="{Binding Path=CancelCommand, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Button x:Name="Ok" Content="OK" Width="100" IsDefault="True"
                                        Command="{Binding Path=SubmitCommand, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>