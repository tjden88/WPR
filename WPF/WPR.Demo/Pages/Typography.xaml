<Page x:Class="WPR.Demo.Pages.Typography"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:models="clr-namespace:WPR.Demo.Models"
      mc:Ignorable="d" 
      Tag="2"
      Loaded="Typography_OnLoaded"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Текст">
    <Grid>
        <StackPanel Orientation="Vertical">
            <ItemsControl Name="ListBoxText2">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:StyleViewModel}">
                        <Grid Margin="10">
                            <TextBlock Style="{Binding Style}"
                                       Text="{Binding Name}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Page>
